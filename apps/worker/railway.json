{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter @overhead/worker build",
    "watchPatterns": ["/apps/worker/**", "/packages/**", "/package.json", "/bun.lock"]
  },
  "deploy": {
    "startCommand": "bun run start:worker",
    "restartPolicyType": "ALWAYS"
  }
}

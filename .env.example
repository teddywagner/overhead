# Placeholders only. Copy to .env and fill in. Never commit real values.
# For local development, `bunx supabase status -o env` prints the local
# SUPABASE_URL / PUBLISHABLE_KEY / SECRET_KEY / DB_URL values.

APP_NAME=Overhead
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# adsb_lol (default) | airplanes_live (feeders only since ~Aug 2026) | mock
AIRCRAFT_PROVIDER=adsb_lol
ADSB_LOL_BASE_URL=https://api.adsb.lol
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live
# Identifies you to the ADS-B provider, e.g. "overhead/0.1 (you@example.com)".
# (AIRPLANES_LIVE_USER_AGENT is still accepted as the old name.)
AIRCRAFT_PROVIDER_USER_AGENT=
WORKER_POLL_INTERVAL_SECONDS=15

DEFAULT_SEARCH_RADIUS_NM=5
DEFAULT_OVERHEAD_RADIUS_M=1200
DEFAULT_MAX_ALTITUDE_FT=15000
DEFAULT_TIMEZONE=America/New_York

DEVICE_SIGNED_URL_TTL_SECONDS=300

# --- Optional (defaults shown) ------------------------------------------------
# LOG_LEVEL=info                      # debug | info | warn | error | silent
# CORS_ALLOWED_ORIGINS=               # comma-separated browser origins; empty = none
# TRUST_PROXY=false                   # true only behind a proxy that sets X-Forwarded-For
# API_BODY_LIMIT_BYTES=65536
# PASS_GAP_TIMEOUT_SECONDS=300        # finalise a pass after this long unseen
# OVERFLIGHT_POINT_SAMPLE_SECONDS=30  # at most one stored point per interval
# OVERFLIGHT_POINT_MAX_PER_PASS=200
# RETENTION_INTERVAL_MINUTES=60       # how often the worker runs private.apply_retention()
# MOCK_SCENARIO=direct-crossing       # with AIRCRAFT_PROVIDER=mock: direct-crossing | near-miss | busy
# ENRICHMENT_PROVIDER=adsbdb          # adsbdb | none (off automatically with the mock provider)
# ADSBDB_BASE_URL=https://api.adsbdb.com
# ENRICHMENT_INTERVAL_SECONDS=30      # how often to look up new aircraft/flights
# ENRICHMENT_BATCH_SIZE=10            # lookups of each kind per round
# DISPLAY_INTERVAL_SECONDS=60         # how often each frame's display selection is re-evaluated

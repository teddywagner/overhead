{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run build",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/bun.lock",
      "/railway/api.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run start:api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

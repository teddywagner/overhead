{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run build",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/package.json",
      "/bun.lock",
      "/railway/worker.json"
    ]
  },
  "deploy": {
    "startCommand": "bun run start:worker",
    "restartPolicyType": "ALWAYS"
  }
}
